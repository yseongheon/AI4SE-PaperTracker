# AI4SE PaperTracker 环境变量模板
# 用法：复制本文件为 backend/.env 并填写实际值（backend/.env 已被 .gitignore 忽略）

# DeepSeek API 密钥（M2 起用于 AI4SE 分类与中文摘要，必填）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 数据库（默认 SQLite，位于项目 data/ 目录，相对 backend/ 运行目录）
DATABASE_URL=sqlite:///../data/papers.db

# LLM 月度成本上限（美元，超出自动暂停精标并记录日志）
LLM_COST_LIMIT_USD=5.0

# 爬取参数：每次增量回溯天数 / 每日调度时间（北京时间）
CRAWL_LOOKBACK_DAYS=3
CRAWL_SCHEDULE_HOUR=9
CRAWL_SCHEDULE_MINUTE=30
